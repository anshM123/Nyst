# Everything below is either a secret, a local artefact, or dead weight.
# A build context is not a place to be relaxed: anything copied in is
# recoverable from the image layers even if a later step deletes it.

# --- secrets and credentials -------------------------------------------
.env
.env.*
!.env.example
.secrets/
secrets/
credentials/
keys/
.signing/
nyst-local-keys/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.token
*.secret

# --- version control and history ---------------------------------------
.git
.gitignore
.gitattributes
.github

# --- local databases and dumps -----------------------------------------
postgres-data/
pgdata/
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# --- logs and local run state ------------------------------------------
*.log
logs/
tmp/
temp/
.cache/

# --- build output (the image builds its own) ---------------------------
# `**/` because a bare pattern matches only at the root: Docker uses Go's
# filepath.Match, where `*` does not cross a path separator.
**/node_modules
**/dist
build/
out/
**/*.tsbuildinfo

# --- test and QA artefacts ---------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
screenshots/
artifacts/

# --- release archives ---------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
Nyst.ai-phase*-frozen/
nyst-phase*-frozen/

# --- editor and OS noise ------------------------------------------------
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# --- docs are not needed at runtime -------------------------------------
# `*.md` matches only root-level markdown; docs/ is excluded wholesale above
# it. The negation is deliberately LAST and deliberately root-scoped: a bare
# `README.md` pattern cannot match a nested path, so this re-includes the
# project README and nothing inside any dependency.
docs/
*.md
!/README.md
