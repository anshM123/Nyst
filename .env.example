# PostgreSQL (integration tests + migrations). Never commit real values.
DATABASE_URL=postgres://outcome:outcome@localhost:5432/outcome

# Ed25519 signing keys, base64-encoded DER (PKCS8 private / SPKI public).
# Generate with: node --experimental-strip-types scripts/genkeys.ts
# NEVER commit real keys. Local dev keys are NOT hardware-backed attestation.
OUTCOME_SIGNING_KEY_ID=dev-local-1
OUTCOME_SIGNING_PRIVATE_KEY_B64=
OUTCOME_SIGNING_PUBLIC_KEY_B64=

# Gate-3 live canary (dedicated disposable private organization repository only).
# Token: fine-grained, repository Administration write + Metadata read, org Members read.
NYST_GITHUB_TOKEN=
NYST_GITHUB_OWNER=nyst-ai-outcomes
NYST_GITHUB_REPOSITORY=nyst-permission-fixture
NYST_GITHUB_PRINCIPAL=chikookutti-cyber
NYST_GITHUB_BASELINE_PERMISSION=read
NYST_GITHUB_TEST_PERMISSION=write

# Gate-5 / read-only integration preflight. The access token stays process-only.
NYST_OKTA_ACCESS_TOKEN=
NYST_OKTA_ORG_URL=https://example.okta.com
NYST_OKTA_TEST_USER_ID=00u_example_fixture

# Gate-7 live canary (Stripe sandbox/test mode only). Never use a live key.
# Supply NYST_STRIPE_API_KEY only through a secure process environment.
NYST_STRIPE_API_KEY=

# Product decision-webhook signing source. Persist only env:NYST_WEBHOOK_SECRET.
NYST_WEBHOOK_SECRET=

# =====================================================================
# PRODUCTION DEPLOYMENT (docker-compose.yml)
#
# Every value here is a placeholder. Nyst refuses to start in production
# on unsafe configuration rather than warning and continuing — the exact
# rules are in src/product/config.ts.
# =====================================================================

NODE_ENV=production

# The signing identity MUST persist across restarts. A receipt signed by a
# key that no longer exists is not proof of anything, so an ephemeral
# development identity is rejected outright under NODE_ENV=production, as is
# a known development key id.
# Generate with: node --experimental-strip-types scripts/genkeys.ts

# Where Nyst is actually reachable. Required, and must be HTTPS: it is the
# origin used in webhook and Slack links, and session cookies are Secure.
NYST_PUBLIC_ORIGIN=https://nyst.example.com

# Bind address published on the host. Keep it on loopback and terminate TLS
# in front of Nyst; 0.0.0.0 publishes the API to every interface.
NYST_BIND=127.0.0.1

# Trust X-Forwarded-* headers. Enable ONLY behind a proxy you control:
# trusting them from an untrusted network lets any client claim any client
# IP, which makes the per-IP rate limiter decoration. Leaving it off behind a
# real proxy has the opposite failure — every request shares one bucket.
NYST_TRUST_PROXY=false

# TLS to PostgreSQL. Opt in explicitly. Do NOT set
# NYST_DATABASE_SSL_REJECT_UNAUTHORIZED=false to make a certificate problem go
# away: unverified TLS is encryption without authentication. Supply a CA.
NYST_DATABASE_SSL=false

# PostgreSQL container credentials used by docker-compose.
POSTGRES_USER=nyst
POSTGRES_PASSWORD=
POSTGRES_DB=nyst

# Worker loop interval. Lower means faster reconciliation and more database
# load; the default is a reasonable balance for a design-partner deployment.
NYST_WORKER_INTERVAL_MS=1000
