# Nyst v0.3.1 — configuration template.
#
# Copy to `.env` and fill in. EVERY CREDENTIAL FIELD IS DELIBERATELY EMPTY, and
# committing a filled-in copy of this file is the mistake this template exists
# to prevent. `.env` is gitignored; `.env.example` is not.
#
# A test asserts that every NYST_* variable the code reads appears here, so this
# file cannot silently fall behind the code again.

# ---------------------------------------------------------------- required ---

DATABASE_URL=postgres://nyst:nyst@localhost:5432/nyst

# Receipts are signed. In PRODUCTION both of these are required and startup
# fails closed without them — a signing identity generated per boot cannot
# verify yesterday's receipts. Generate an Ed25519 key pair; never commit it.
OUTCOME_SIGNING_KEY_ID=
OUTCOME_SIGNING_PRIVATE_KEY_B64=
OUTCOME_SIGNING_PUBLIC_KEY_B64=

# Local development only: accept a throwaway signing identity. REFUSED in
# production, by name, at startup.
NYST_LOCAL_EPHEMERAL_SIGNING=true

# ------------------------------------------------------------------ server ---

NODE_ENV=development
NYST_HOST=127.0.0.1
NYST_PORT=4080
NYST_PUBLIC_ORIGIN=https://nyst.example.com
NYST_SECURE_COOKIES=false
NYST_TRUST_PROXY=false
NYST_DATABASE_SSL=false
NYST_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Run the worker inside the web process. Convenient locally; in production run
# `scripts/startWorker.ts` as its own process instead.
NYST_RUN_EMBEDDED_WORKER=false
NYST_WORKER_INTERVAL_MS=1000
NYST_WORKER_INSTANCE_ID=

# ------------------------------------------------- Google Sign-In (v0.3.1) ---
#
# Leave unset and nothing breaks: /login renders no Google button and
# /auth/google/start returns 503 naming what is missing.
#
# NYST_GOOGLE_CLIENT_SECRET_REF is a REFERENCE — the NAME of the variable
# holding the secret, never the secret. Pasting the secret there is refused at
# startup. See docs/OWNER-SETUP.md.

NYST_GOOGLE_CLIENT_ID=
NYST_GOOGLE_CLIENT_SECRET_REF=env:NYST_GOOGLE_CLIENT_SECRET
NYST_GOOGLE_CLIENT_SECRET=
NYST_GOOGLE_REDIRECT_URI=https://nyst.example.com/auth/google/callback
# Accept a Google account whose email Google has NOT verified. Leave false.
NYST_GOOGLE_ALLOW_UNVERIFIED_EMAIL=false

# --------------------------------------------------------------- providers ---
#
# Tokens go here; the integration stores only the REFERENCE (env:NYST_GITHUB_TOKEN).
# Start in Shadow and read the findings before granting any write scope.

NYST_GITHUB_TOKEN=
NYST_GITHUB_OWNER=
NYST_GITHUB_REPOSITORY=
NYST_GITHUB_PRINCIPAL=

# Your Okta organization URL, e.g. https://example.okta.com
#
# CONFIGURATION, NOT A SECRET. Nyst cannot guess which Okta tenant a credential
# belongs to, and unlike GitHub and Stripe there is no endpoint that reveals it
# from the token alone. Until there is a field for this in the Integrations
# page, the Okta preflight needs it here — and says so by name when it is
# missing, rather than failing opaquely.
NYST_OKTA_ORG_URL=

NYST_OKTA_ACCESS_TOKEN=
NYST_OKTA_TOKEN_TYPE=SSWS
NYST_OKTA_EXPECTED_LOGIN=
# Only when using DPoP-bound Okta tokens.
NYST_OKTA_DPOP_PRIVATE_JWK=

NYST_STRIPE_CREDENTIAL=

# ------------------------------------ customer-supplied credentials (v0.3.3)
#
# The three variables above are how the OPERATOR configures providers for their
# own deployment. They cannot serve a hosted product: a customer who signs up on
# your site cannot set an environment variable on your server, so without the
# key below the only organization that can ever connect a provider is yours.
#
# Set this and customers can paste their own GitHub / Okta / Stripe credential
# into the Integrations page. Nyst encrypts it with AES-256-GCM under this key,
# scoped to that organization and environment, and never displays it again.
#
#   openssl rand -base64 32
#
# EXACTLY 32 bytes, base64. Anything else is refused at boot rather than
# accepted as a weaker key.
#
# WITHOUT IT, the connect form answers 503 explaining why. It NEVER falls back
# to storing a customer credential in plaintext.
#
# ROTATING IT makes every stored credential undecryptable and customers must
# supply theirs again. Nyst says so plainly rather than reporting a provider
# outage. Back it up wherever you back up your signing key.
NYST_CREDENTIAL_KEY=

# --------------------------------------- operator entitlement grant (v0.3.3)
#
# Entitlement is deliberately NOT self-service: an organization upgrading
# itself is a billing decision, not a product setting. This is the OPERATOR
# door, for a deployment you control.
#
# Set BOTH. The organization is named by slug so a grant cannot silently apply
# to every tenant. Applied once at startup, through the same audited path as
# any other entitlement change.
#
#   NYST_GRANT_ENTITLEMENT=enterprise      trial | protect | scale | enterprise
#   NYST_GRANT_ENTITLEMENT_ORG=acme        the organization slug
#
# This permits an organization to ASK for Canary or Enforced. Whether either is
# SAFE is still decided independently by readiness, policy, the Autonomy Line,
# Freeze and Authority. Money decides what you may ask for, never what is safe.
NYST_GRANT_ENTITLEMENT=
NYST_GRANT_ENTITLEMENT_ORG=

# Signing secret for outbound decision webhooks.
NYST_WEBHOOK_SECRET=

# ---------------------------------------------------------------- email ---
#
# Outbound mail: password reset links, and contact/quote notifications. Nyst
# sends nothing else. Leave NYST_SMTP_HOST unset and password reset reports that
# delivery is unavailable rather than pretending a link was sent.
#
# NYST_SMTP_PASSWORD_REF is a REFERENCE, resolved through the SecretProvider at
# send time -- never the password itself.

NYST_SMTP_HOST=
NYST_SMTP_PORT=587
NYST_SMTP_SECURE=false
NYST_SMTP_USER=
NYST_SMTP_PASSWORD_REF=env:NYST_SMTP_PASSWORD
NYST_SMTP_PASSWORD=
NYST_EMAIL_FROM=

# ------------------------------------------------------ contact and leads ---
#
# The address a visitor may write to directly. UNSET MEANS NO ADDRESS IS
# ADVERTISED, rather than one that bounces.

NYST_SALES_CONTACT_EMAIL=

# ----------------------------------------------------------- development ---
#
# All of these are refused in production by src/product/config.ts.

# A fake provider runtime, so the product can be driven with no real credential.
NYST_ENABLE_DEVELOPMENT_FAKE=false
# Log credential RESOLUTION decisions. Never logs a credential value.
NYST_DEBUG_LOG_CREDENTIALS=false

# Seed a demo account at boot.
NYST_ENABLE_DEMO=false
NYST_DEMO_ORG=
NYST_DEMO_EMAIL=
NYST_DEMO_PASSWORD=

# Used by scripts/verify.ts against a running instance.
NYST_URL=http://127.0.0.1:4080
NYST_VERIFY_ORGANIZATION=
NYST_VERIFY_EMAIL=
NYST_VERIFY_PASSWORD=

NYST_BOOTSTRAP_ORGANIZATION=
