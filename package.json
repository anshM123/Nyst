{
  "name": "nyst",
  "version": "0.3.2",
  "private": true,
  "description": "Nyst \u2014 effect-control infrastructure for autonomous software.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "docs/product"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p packages/sdk/tsconfig.json && tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.api.json",
    "typecheck": "tsc -p packages/sdk/tsconfig.json && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.api.json",
    "test": "npm run build && node --test --test-concurrency=4 \"dist/tests/*.test.js\"",
    "test:github:live": "npm run build && node --experimental-strip-types scripts/verifyGitHubLive.ts",
    "test:github:gate4-live": "npm run build && node --experimental-strip-types scripts/verifyGitHubGate4Live.ts",
    "test:okta:gate5-live": "npm run build && node --experimental-strip-types scripts/verifyOktaGate5Live.ts",
    "test:gate6:live": "npm run build && node --experimental-strip-types scripts/verifyGate6Live.ts",
    "test:stripe:gate7-live": "npm run build && node --experimental-strip-types scripts/verifyStripeGate7Live.ts",
    "start:product": "npm run build && node --experimental-strip-types scripts/startProduct.ts",
    "start:worker": "npm run build && node --experimental-strip-types scripts/startWorker.ts",
    "migrate": "node --experimental-strip-types scripts/migrate.ts"
  },
  "devDependencies": {
    "@nyst-ai/sdk": "file:packages/sdk",
    "@types/node": "^25.6.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.11.3",
    "pg": "^8.16.3"
  }
}
